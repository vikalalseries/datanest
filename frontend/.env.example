# Firebase console -> Project settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8000

# DEV ONLY: skip login (must match backend AUTH_DISABLED)
VITE_AUTH_DISABLED=false

# Production build (Vercel): set these in the Vercel dashboard, NOT in a committed file.
# VITE_API_BASE_URL must be your Render URL (https://...). VITE_AUTH_DISABLED is ignored in production builds.

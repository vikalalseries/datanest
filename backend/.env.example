ENV=development
# Supabase is used as the database/storage only (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Firebase project id (Firebase console -> Project settings -> General)
FIREBASE_PROJECT_ID= 
# Project Settings -> Database -> Connection string (use the pooler string on Render)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# Gemini (used from Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5

# DEV ONLY: skip login (refused when ENV=production)
AUTH_DISABLED=false
# Models tried in order if GEMINI_MODEL is overloaded (comma separated model ids, see client.models.list())
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash
